# Copy this file to .env and fill in real values. Never commit .env.

PORT=5001
MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/eventghar
JWT_SECRET=use-a-long-random-string-at-least-32-characters

# Google Sign-In. Create an OAuth Client ID (type: Web application) at
# https://console.cloud.google.com/apis/credentials — add your frontend URL
# (e.g. http://localhost:5173) under "Authorized JavaScript origins".
# This must be the SAME client ID used in frontend/.env's VITE_GOOGLE_CLIENT_ID.
GOOGLE_CLIENT_ID=

# Where the React site runs. Comma-separate several origins if needed.
FRONTEND_URL=http://localhost:5173
# Public address of THIS backend. eSewa redirects the buyer here after paying.
BACKEND_URL=http://localhost:5001

# eSewa. The values below are the public TEST credentials.
# For real payments use your live product code, secret key and live form URL.
ESEWA_PRODUCT_CODE=EPAYTEST
ESEWA_SECRET_KEY=
ESEWA_FORM_URL=https://rc-epay.esewa.com.np/api/epay/main/v2/form

# Gmail app password for ticket emails
EMAIL_USER=
EMAIL_PASS=

# Cloudinary (event images)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Set to 1 when the backend runs behind a proxy (Render, Railway, Nginx)
# so the login rate limiter sees each visitor's real IP.
TRUST_PROXY=
